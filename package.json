{
  "name": "peyvand-crm",
  "version": "0.5.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run test:crm",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop/runtime --ignore-pattern desktop/ui --ignore-pattern tests/*.bundle.mjs --ignore-pattern windows-release",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "build:vercel": "next build --webpack",
    "dev:vercel": "next dev",
    "start:vercel": "next start",
    "test:crm": "esbuild tests/crm.test.ts --bundle --platform=node --format=esm --packages=external --outfile=tests/crm.bundle.mjs && node --test tests/crm.bundle.mjs",
    "test:http": "node tests/http-smoke.mjs",
    "build:sites": "bash scripts/build-verified.sh",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build:desktop": "node desktop/build.mjs",
    "package:windows": "npm run build:desktop && electron-builder --config desktop/electron-builder.yml --win dir --x64",
    "desktop": "electron desktop/runtime",
    "portable:windows": "npm run build:desktop && electron-builder --config desktop/electron-builder.yml --win portable --x64",
    "installer:windows": "npm run build:desktop && electron-builder --config desktop/electron-builder.yml --win nsis --x64",
    "test:desktop": "esbuild tests/desktop.test.mjs --bundle --platform=node --format=esm --outfile=tests/desktop.bundle.mjs && node --test tests/desktop.bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/vazirmatn": "^5.2.8",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "44.2.0",
    "electron-builder": "26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
